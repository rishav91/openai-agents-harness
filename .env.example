# Application key — never pass into the sandbox.
# Needs api.agents.read, api.agents.write, api.responses.write
OPENAI_API_KEY=

# Restricted environment key from platform.openai.com/agents (environments keys).
# Same org/project/owner as OPENAI_API_KEY. All other permissions None.
# Passed into the container as CODEX_API_KEY only.
OPENAI_EXECUTOR_API_KEY=

# Per-turn USD ceiling. Cancel at 100% of estimated spend (Phase 1). Required to start.
COST_BOUND_USD=

# Model id for the Agents API session.
AGENT_MODEL=gpt-6-astra

# Optional
# MAX_RESEARCH_COUNT=12
# RUNS_DIR=./runs
# DOCKER_IMAGE=equity-harness-sandbox:latest

# Traces: start Jaeger then point here. Leave unset to disable export.
# docker compose -f observability/docker-compose.yml up -d
# UI: http://127.0.0.1:16686
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
OTEL_SERVICE_NAME=equity-harness
